# Copy to .env (repo root) and adjust. The backend reads it on startup;
# real environment variables take precedence.

# Postgres (matches docker-compose.yml and scripts/services.sh)
DATABASE_URL=postgresql+asyncpg://freight:freight@127.0.0.1:5432/freight

# Redis, used by the arq job queue
REDIS_URL=redis://127.0.0.1:6379/0

# JWT signing secret. CHANGE THIS outside local development:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-only-change-me
JWT_LIFETIME_SECONDS=86400

# Where proof-of-delivery photos are stored (relative to backend/)
UPLOAD_DIR=uploads
MAX_UPLOAD_BYTES=5242880

# Browser origins allowed to call the API (comma separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Pricing: price = max(kg, m3 * CUBIC_FACTOR) * zone rate per kg.
# DEFAULT_RATE_PER_KG is used (and the quote marked provisional) while the
# delivery address has no zone yet.
CUBIC_FACTOR=250
DEFAULT_RATE_PER_KG=0.60

# Solver
SOLVER_TIME_LIMIT_S=10

# Only "dev" allows the default JWT secret above. Any other value, or leaving
# APP_ENV unset (it defaults to "prod"), needs a JWT_SECRET of 32+ characters.
# `make seed` also refuses to run unless APP_ENV=dev.
APP_ENV=dev
# Business timezone for the driver's "today" and invoice months
BUSINESS_TZ=Australia/Sydney
