# Optional settings. Every value below is the default, so you don't need a .env
# file to run the app.
#
# Nothing loads this file on its own. To use it, copy it to .env and export
# the values into your shell before running make:
#   cp .env.example .env
#   set -a; source .env; set +a
#   make dev

# Ports for `make dev` (scripts/dev.sh). `make api` uses API_PORT too.
API_PORT=8000
WEB_PORT=5173

# Browser origins allowed to call the API directly (comma separated).
# The Vite dev server proxies /api, so you only need this when another
# page calls the API itself.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Only for `make web` on its own (scripts/dev.sh sets these from the ports above).
# VITE_API_TARGET=http://localhost:8000
# VITE_PORT=5173
