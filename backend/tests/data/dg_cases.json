{
  "_comment": "Shared by backend/tests/test_dg.py and frontend/src/dg/rules.test.ts. Each case: two DgInfo values (null = general freight) and the expected pair status.",
  "cases": [
    {"name": "general with anything", "a": null, "b": {"dg_class": "5.1"}, "expect": "ok"},
    {"name": "flammable liquid with oxidiser", "a": {"dg_class": "3"}, "b": {"dg_class": "5.1"}, "expect": "incompatible"},
    {"name": "flammable liquid with corrosive", "a": {"dg_class": "3"}, "b": {"dg_class": "8"}, "expect": "ok"},
    {"name": "same product never conflicts", "a": {"dg_class": "3", "packing_group": "II"}, "b": {"dg_class": "3", "packing_group": "II"}, "expect": "ok"},
    {"name": "subsidiary hazard counts", "a": {"dg_class": "3", "subsidiary": ["8"]}, "b": {"dg_class": "4.3"}, "expect": "incompatible"},
    {"name": "subsidiary vs subsidiary", "a": {"dg_class": "6.1", "subsidiary": ["3"]}, "b": {"dg_class": "8", "subsidiary": ["5.1"], "t92": []}, "expect": "incompatible"},
    {"name": "exception 2 small receptacles", "a": {"dg_class": "2.1", "container": "cylinder"}, "b": {"dg_class": "3", "container": "drum"}, "expect": "ok"},
    {"name": "exception 2 both tanks", "a": {"dg_class": "2.1", "container": "tank_over_500l"}, "b": {"dg_class": "3", "container": "tank_over_500l"}, "expect": "incompatible"},
    {"name": "exception 3 cylinders", "a": {"dg_class": "2.1", "container": "cylinder"}, "b": {"dg_class": "2.2", "subsidiary": ["5.1"], "container": "cylinder"}, "expect": "ok"},
    {"name": "exception 3 bulk oxidising gas", "a": {"dg_class": "2.1", "container": "cylinder"}, "b": {"dg_class": "2.2", "subsidiary": ["5.1"], "container": "tank_over_500l"}, "expect": "incompatible"},
    {"name": "exception 4 cylinders", "a": {"dg_class": "2.3", "container": "cylinder"}, "b": {"dg_class": "2.2", "subsidiary": ["5.1"], "container": "cylinder"}, "expect": "ok"},
    {"name": "exception 3 plain 2.2", "a": {"dg_class": "2.1", "container": "tank_over_500l"}, "b": {"dg_class": "2.2", "container": "tank_over_500l"}, "expect": "ok"},
    {"name": "exception 5 not fire-risk", "a": {"dg_class": "5.1", "t92": []}, "b": {"dg_class": "9"}, "expect": "ok"},
    {"name": "exception 5 fire-risk", "a": {"dg_class": "5.1", "t92": []}, "b": {"dg_class": "9", "fire_risk": true}, "expect": "incompatible"},
    {"name": "exception 6 unanswered", "a": {"dg_class": "8"}, "b": {"dg_class": "8", "packing_group": "III"}, "expect": "check"},
    {"name": "exception 6 answered none", "a": {"dg_class": "8", "t92": []}, "b": {"dg_class": "8", "packing_group": "III", "t92": []}, "expect": "ok"},
    {"name": "table 9.2 acid with alkali", "a": {"dg_class": "8", "t92": ["acid_strong"]}, "b": {"dg_class": "8", "t92": ["alkali_strong"]}, "expect": "incompatible"},
    {"name": "table 9.2 cyanide with acid", "a": {"dg_class": "6.1", "t92": ["cyanide"]}, "b": {"dg_class": "8", "t92": ["acid_other"]}, "expect": "incompatible"},
    {"name": "table 9.2 calcium hypochlorite with TCCA", "a": {"dg_class": "5.1", "t92": ["calcium_hypochlorite"]}, "b": {"dg_class": "5.1", "t92": ["chloroisocyanuric_acid"]}, "expect": "incompatible"},
    {"name": "table 9.2 nitromethane with class 6", "a": {"dg_class": "3", "t92": ["nitromethane"]}, "b": {"dg_class": "6.1", "t92": []}, "expect": "incompatible"},
    {"name": "food with toxic", "a": {"food": true}, "b": {"dg_class": "6.1"}, "expect": "incompatible"},
    {"name": "food with corrosive", "a": {"food": true}, "b": {"dg_class": "8"}, "expect": "incompatible"},
    {"name": "food with flammable liquid", "a": {"food": true}, "b": {"dg_class": "3"}, "expect": "ok"},
    {"name": "food with fire-risk", "a": {"food": true}, "b": {"fire_risk": true}, "expect": "ok"},
    {"name": "fire-risk with oxidiser", "a": {"fire_risk": true}, "b": {"dg_class": "5.1"}, "expect": "incompatible"},
    {"name": "fire-risk with flammable gas", "a": {"fire_risk": true}, "b": {"dg_class": "2.1"}, "expect": "ok"},
    {"name": "explosive with flammable liquid", "a": {"dg_class": "1", "explosive_code": "1.4S"}, "b": {"dg_class": "3"}, "expect": "incompatible"},
    {"name": "explosive with general freight", "a": {"dg_class": "1", "explosive_code": "1.4S"}, "b": null, "expect": "ok"},
    {"name": "explosives same group", "a": {"dg_class": "1", "explosive_code": "1.4S"}, "b": {"dg_class": "1", "explosive_code": "1.4S", "un_number": "0012"}, "expect": "check"},
    {"name": "explosives different group", "a": {"dg_class": "1", "explosive_code": "1.4S"}, "b": {"dg_class": "1", "explosive_code": "1.4G"}, "expect": "incompatible"},
    {"name": "radioactive with flammable gas", "a": {"dg_class": "7"}, "b": {"dg_class": "2.1"}, "expect": "incompatible"},
    {"name": "organic peroxides together", "a": {"dg_class": "5.2"}, "b": {"dg_class": "5.2", "un_number": "3105"}, "expect": "ok"},
    {"name": "infectious with oxidiser (6.2 maps to 6)", "a": {"dg_class": "6.2"}, "b": {"dg_class": "5.1", "t92": []}, "expect": "ok"},
    {"name": "spontaneous combustible with corrosive", "a": {"dg_class": "4.2"}, "b": {"dg_class": "8"}, "expect": "ok"},
    {"name": "dangerous when wet with corrosive", "a": {"dg_class": "4.3"}, "b": {"dg_class": "8"}, "expect": "incompatible"}
  ]
}
